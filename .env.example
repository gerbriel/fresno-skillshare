# Copy to .env.local and fill in from your Supabase project settings (Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Free form service endpoint for the landing page contact form. Messages
# are emailed to the admins; nothing is stored in the database.
# FormSubmit (no signup): use https://formsubmit.co/ajax/<your-random-alias>
#   - get the alias by activating your email at https://formsubmit.co
# Formspree: use your form's endpoint, e.g. https://formspree.io/f/<form-id>
# Leave unset to show the Instagram contact instead of the form.
VITE_CONTACT_ENDPOINT=
