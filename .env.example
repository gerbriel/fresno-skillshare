# Copy to .env.local and fill in from your Supabase project settings (Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudflare Turnstile (free captcha) for the public contact form.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Site key goes here (public); the secret key goes in the submit-contact
# Edge Function's env as TURNSTILE_SECRET_KEY. Leave unset to disable the
# captcha (the form still works, protected only by rate limiting).
VITE_TURNSTILE_SITE_KEY=
